# IBKR Gateway (used by docker-compose.yml)
TWS_USERID=
TWS_PASSWORD=
VNC_SERVER_PASSWORD=

# IBKR runtime
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=2
IBKR_REQUIRED_ACCOUNT_ID=
USE_IBKR=false

# Mode flags
DRY_RUN=true
BE_FORCE_DRY_RUN=true
IBKR_MODE=paper
TRADING_MODE=paper
BOT_MODE=paper

# Data providers
POLYGON_API_KEY=
FINNHUB_API_KEY=

# Telegram
TG_TOKEN=
TG_CHAT_ID=

# Server
PORT=3000
